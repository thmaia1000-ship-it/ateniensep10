                <SelectCommand>
                  <DbCommand CommandType="Text" ModifiedByUser="true">
                    <CommandText>SELECT 
    c.horario,
    c.data,
    c.valor_total,
    c.mensalidades_paga,
    c.ID_caixa,
    IFNULL(t.soma_total, 0) AS valor_total_somado,
    m.ano_letivo,
    m.ID_mensalidade
FROM tb_caixa c
INNER JOIN tb_mensalidades m ON c.idmensalidade = m.ID_mensalidade
LEFT JOIN (
    SELECT 
        idmensalidade,
        mensalidades_paga, 
        SUM(valor_total) AS soma_total
    FROM tb_caixa
    WHERE descricao = 'Mensalidade'
      AND idaluno = @idaluno
    GROUP BY idmensalidade, mensalidades_paga
) t ON c.idmensalidade = t.idmensalidade
   AND c.mensalidades_paga = t.mensalidades_paga
WHERE 
    c.descricao = 'Mensalidade'
    AND c.idaluno = @idaluno
    AND m.ano_letivo = @ano_letivo
ORDER BY 
    m.ID_mensalidade,
    c.mensalidades_paga
</CommandText>
